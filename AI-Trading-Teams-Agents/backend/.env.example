# Copy to backend/.env and fill in real values. Never commit backend/.env.
OPENAI_API_KEY=
EXA_API_KEY=

# Only needed if you switch the provider back to Groq (see below).
GROQ_API_KEY=

# Optional overrides (defaults shown).
# BACKEND_LLM_PROVIDER=openai
# BACKEND_DEEP_THINK_LLM=gpt-5.5
# BACKEND_QUICK_THINK_LLM=gpt-5.4-mini
# BACKEND_LLM_MAX_RETRIES=8

# Token-budget knobs. Defaults are the repo's own (full analysis depth) and
# only need lowering on a rate-capped provider. Groq's free tier (8k TPM)
# needs roughly: MAX_INDICATORS=3, MAX_INDICATOR_LOOKBACK=15, NEWS_LIMIT=4.
# BACKEND_NEWS_LIMIT=20
# BACKEND_GLOBAL_NEWS_LIMIT=10
# BACKEND_MAX_INDICATORS=8
# BACKEND_MAX_INDICATOR_LOOKBACK=      # empty = uncapped
